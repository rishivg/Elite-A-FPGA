root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{scala,sbt,mjs,json,yml,yaml}]
indent_size = 2

[*.{py,c,cpp,h}]
indent_size = 4

[Makefile]
indent_style = tab

[third_party/**]
trim_trailing_whitespace = false
insert_final_newline = false
