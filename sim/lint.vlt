`verilator_config
// Upstream PicoRV32 uses deliberate blocking temporaries and unnamed generates.
lint_off -rule BLKSEQ -file "*third_party/picorv32.v"
lint_off -rule GENUNNAMED -file "*third_party/picorv32.v"
// Spinal emits multiple named modules per file and retains some unused signals.
lint_off -rule DECLFILENAME -file "*build/rtl/*.v"
lint_off -rule DECLFILENAME -file "*third_party/picorv32.v"
lint_off -rule UNUSEDSIGNAL -file "*build/rtl/*.v"
lint_off -rule UNUSEDSIGNAL -file "*third_party/picorv32.v"
lint_off -rule UNUSEDPARAM -file "*third_party/picorv32.v"
